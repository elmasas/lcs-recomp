// --- Hint text (game/ControlText.cpp) -----------------------------------------
// Writes the PC key in place of the PSP button text, so verify mode reports
// the out buffer as different by design; v0 (the characters used) matches.
DECOMP_FN(0x0887B534u, ResolveControlToken, V0, Text)
