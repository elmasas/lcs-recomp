// Guest functions replaced by hand-written C++.
//
//   DECOMP_FN(guest address, thunk name, result, regions)
//
// result:  VOID, or V0 when the caller reads a return value.
// regions: the guest memory the function may write, used by LCS_DECOMP=verify
//          to compare the rewrite against the recompiled original.
//
// After editing this list run:  python tools/decomp/apply_hooks.py

// --- Platform pad (game/PadDevice.cpp) -------------------------------------
DECOMP_FN(0x0886AC24u, CPspPad_Open, V0, PadDevice)
DECOMP_FN(0x0886AC80u, CPspPad_Close, VOID, PadDevice)
DECOMP_FN(0x0886AC88u, CPspPad_Update, VOID, PadDevice)
DECOMP_FN(0x0886AED8u, CPspPad_Reset, VOID, PadDevice)
DECOMP_FN(0x08837F9Cu, CPadDevice_Open, V0, PadDevice)
DECOMP_FN(0x08837FCCu, CPadDevice_Close, VOID, PadDevice)
DECOMP_FN(0x08837FE8u, CPadDevice_Update, VOID, PadDevice)

